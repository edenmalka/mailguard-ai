# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Shared secret used to verify HMAC signatures on requests from the Gmail add-on.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MAILGUARD_HMAC_SECRET=

# Maximum accepted size of a raw email, in bytes (default: 2 MB).
MAILGUARD_MAX_MESSAGE_BYTES=2097152

# How old (in seconds) a signed request may be before it is rejected (replay protection).
MAILGUARD_SIGNATURE_MAX_AGE_SECONDS=300

# Logging level: DEBUG, INFO, WARNING, ERROR.
MAILGUARD_LOG_LEVEL=INFO

# Expose interactive API docs at /docs. Keep false in production.
MAILGUARD_ENABLE_DOCS=false

# Mail servers whose Authentication-Results headers are trusted (JSON list).
# Only the topmost header is considered, and only if written by one of these.
MAILGUARD_TRUSTED_AUTHSERV_IDS=["mx.google.com"]
